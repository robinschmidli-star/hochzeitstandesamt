generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Canton {
  id              String                @id @default(cuid())
  nameDe          String                @map("name_de")
  nameFr          String?               @map("name_fr")
  nameIt          String?               @map("name_it")
  slug            String                @unique
  abbreviation    String
  description     String?
  metaTitle       String?               @map("meta_title")
  metaDescription String?               @map("meta_description")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  cities          City[]
  offices         CivilRegistryOffice[]
  leads           Lead[]
  vendors         Vendor[]

  @@map("cantons")
}

model City {
  id              String                @id @default(cuid())
  name            String
  slug            String                @unique
  cantonId        String                @map("canton_id")
  postalCode      String?               @map("postal_code")
  description     String?
  metaTitle       String?               @map("meta_title")
  metaDescription String?               @map("meta_description")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  canton          Canton                @relation(fields: [cantonId], references: [id])
  offices         CivilRegistryOffice[]
  leads           Lead[]

  @@map("cities")
}

model CivilRegistryOffice {
  id                         String    @id @default(cuid())
  name                       String
  slug                       String    @unique
  cantonId                   String    @map("canton_id")
  cityId                     String?   @map("city_id")
  addressLine1               String    @map("address_line_1")
  addressLine2               String?   @map("address_line_2")
  postalCode                 String    @map("postal_code")
  city                       String
  phone                      String?
  email                      String?
  websiteUrl                 String    @map("website_url")
  appointmentUrl             String?   @map("appointment_url")
  openingHours               String?   @map("opening_hours")
  latitude                   Float?
  longitude                  Float?
  languages                  String[]  @default([])
  responsibleMunicipalities  String[]  @default([]) @map("responsible_municipalities")
  description                String?
  documentsInfo              String?   @map("documents_info")
  ceremonyInfo               String?   @map("ceremony_info")
  imageUrl                   String?   @map("image_url")
  sourceUrl                  String    @map("source_url")
  lastVerifiedAt             DateTime? @map("last_verified_at")
  published                  Boolean   @default(false)
  metaTitle                  String?   @map("meta_title")
  metaDescription            String?   @map("meta_description")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  canton                     Canton    @relation(fields: [cantonId], references: [id])
  cityRelation               City?     @relation(fields: [cityId], references: [id])
  leads                      Lead[]

  @@map("civil_registry_offices")
}

model GuideArticle {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  category        String
  excerpt         String?
  content         String
  author          String?
  status          String    @default("draft")
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  canonicalUrl    String?   @map("canonical_url")
  publishedAt     DateTime? @map("published_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("guide_articles")
}

model Lead {
  id                        String                @id @default(cuid())
  leadType                  String                @map("lead_type")
  firstName                 String                @map("first_name")
  lastName                  String?               @map("last_name")
  email                     String
  phone                     String?
  cantonId                  String?               @map("canton_id")
  cityId                    String?               @map("city_id")
  registryOfficeId          String?               @map("registry_office_id")
  weddingDate               DateTime?             @map("wedding_date")
  guestCount                Int?                  @map("guest_count")
  budgetRange               String?               @map("budget_range")
  requestedVendorCategories String[]              @default([]) @map("requested_vendor_categories")
  stylePreferences          String[]              @default([]) @map("style_preferences")
  message                   String?
  consentPrivacy            Boolean               @map("consent_privacy")
  consentMarketing          Boolean               @default(false) @map("consent_marketing")
  consentTimestamp          DateTime              @default(now()) @map("consent_timestamp")
  sourcePage                String                @map("source_page")
  utmSource                 String?               @map("utm_source")
  utmMedium                 String?               @map("utm_medium")
  utmCampaign               String?               @map("utm_campaign")
  createdAt                 DateTime              @default(now()) @map("created_at")
  canton                    Canton?               @relation(fields: [cantonId], references: [id])
  city                      City?                 @relation(fields: [cityId], references: [id])
  registryOffice            CivilRegistryOffice?   @relation(fields: [registryOfficeId], references: [id])
  vendorLeads               VendorLead[]

  @@map("leads")
}
model WebsiteLead {
  id                String   @id @default(uuid()) @db.Uuid
  leadType          String   @map("lead_type")
  email             String
  firstName         String   @default("") @map("first_name")
  payload           Json
  dedupeWeddingDate String?  @map("dedupe_wedding_date")
  dedupeLocation    String?  @map("dedupe_location")
  duplicateOfId     String?  @db.Uuid @map("duplicate_of_id")
  status            String   @default("new")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([leadType, email, dedupeWeddingDate, dedupeLocation], map: "website_leads_dedupe_idx")
  @@index([createdAt(sort: Desc)], map: "website_leads_created_at_idx")
  @@map("website_leads")
}

model AnalyticsEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventName   String   @map("event_name")
  sessionId   String   @db.Uuid @map("session_id")
  visitorHash String   @map("visitor_hash")
  path        String
  country     String   @default("CH")
  properties  Json
  occurredAt  DateTime @default(now()) @map("occurred_at")

  @@index([occurredAt(sort: Desc)], map: "analytics_events_occurred_at_idx")
  @@index([eventName, occurredAt(sort: Desc)], map: "analytics_events_name_time_idx")
  @@map("analytics_events")
}

enum AvailabilityStatus {
  available
  unavailable
  unknown
  manual_check
  not_supported

  @@map("availability_status")
}

model VisitorPreferenceProfile {
  id                    String                 @id @default(uuid()) @db.Uuid
  visitorHash           String                 @unique(map: "visitor_preference_profiles_visitor_hash_key") @map("visitor_hash")
  firstSeenAt           DateTime               @default(now()) @map("first_seen_at")
  lastSeenAt            DateTime               @default(now()) @updatedAt @map("last_seen_at")
  locale                String?
  country               String?
  searchContexts        SearchContext[]
  favoriteVenues        FavoriteVenue[]
  availabilityInterests AvailabilityInterest[]

  @@index([lastSeenAt(sort: Desc)], map: "visitor_preference_profiles_last_seen_at_idx")
  @@map("visitor_preference_profiles")
}

model SearchContext {
  id           String                   @id @default(uuid()) @db.Uuid
  visitorHash  String                   @map("visitor_hash")
  sessionId    String?                  @map("session_id") @db.Uuid
  canton       String?
  date         DateTime?                @db.Date
  dateFrom     DateTime?                @map("date_from") @db.Date
  dateTo       DateTime?                @map("date_to") @db.Date
  guests       Int?
  saturdayOnly Boolean?                 @map("saturday_only")
  tag          String?
  elopement    Boolean?
  outdoor      Boolean?
  radiusKm     Int?                     @map("radius_km")
  resultCount  Int?                     @map("result_count")
  createdAt    DateTime                 @default(now()) @map("created_at")
  visitor      VisitorPreferenceProfile @relation(fields: [visitorHash], references: [visitorHash], onDelete: Cascade)
  favorites    FavoriteVenue[]

  @@index([visitorHash, createdAt(sort: Desc)], map: "search_contexts_visitor_time_idx")
  @@index([createdAt(sort: Desc)], map: "search_contexts_created_at_idx")
  @@index([canton, createdAt(sort: Desc)], map: "search_contexts_canton_time_idx")
  @@index([date], map: "search_contexts_date_idx")
  @@map("search_contexts")
}

model FavoriteVenue {
  id              String                   @id @default(uuid()) @db.Uuid
  visitorHash     String                   @map("visitor_hash")
  venueId         String                   @map("venue_id") @db.Uuid
  venueSlug       String                   @map("venue_slug")
  searchContextId String?                  @map("search_context_id") @db.Uuid
  savedAt         DateTime                 @default(now()) @map("saved_at")
  removedAt       DateTime?                @map("removed_at")
  visitor         VisitorPreferenceProfile @relation(fields: [visitorHash], references: [visitorHash], onDelete: Cascade)
  searchContext   SearchContext?           @relation(fields: [searchContextId], references: [id], onDelete: SetNull)

  // A removed favorite is reactivated in place. Analytics retains add/remove history.
  @@unique([visitorHash, venueId], map: "favorite_venues_visitor_venue_key")
  @@index([venueId, removedAt], map: "favorite_venues_venue_active_idx")
  @@index([venueSlug], map: "favorite_venues_venue_slug_idx")
  @@index([searchContextId], map: "favorite_venues_search_context_id_idx")
  @@index([savedAt(sort: Desc)], map: "favorite_venues_saved_at_idx")
  @@map("favorite_venues")
}

model AvailabilityInterest {
  id                 String                   @id @default(uuid()) @db.Uuid
  visitorHash        String                   @map("visitor_hash")
  sessionId          String?                  @map("session_id") @db.Uuid
  venueId            String                   @map("venue_id") @db.Uuid
  venueSlug          String                   @map("venue_slug")
  officeId           String?                  @map("office_id") @db.Uuid
  requestedDate      DateTime?                @map("requested_date") @db.Date
  requestedDateFrom  DateTime?                @map("requested_date_from") @db.Date
  requestedDateTo    DateTime?                @map("requested_date_to") @db.Date
  availabilityStatus AvailabilityStatus       @default(unknown) @map("availability_status")
  checkedAt          DateTime                 @default(now()) @map("checked_at")
  visitor            VisitorPreferenceProfile @relation(fields: [visitorHash], references: [visitorHash], onDelete: Cascade)

  @@index([visitorHash, checkedAt(sort: Desc)], map: "availability_interests_visitor_time_idx")
  @@index([venueId, checkedAt(sort: Desc)], map: "availability_interests_venue_time_idx")
  @@index([officeId, checkedAt(sort: Desc)], map: "availability_interests_office_time_idx")
  @@index([requestedDate], map: "availability_interests_requested_date_idx")
  @@index([availabilityStatus, checkedAt(sort: Desc)], map: "availability_interests_status_time_idx")
  @@map("availability_interests")
}

model RateLimitBucket {
  namespace  String
  clientHash String   @map("client_hash")
  count      Int
  resetAt    DateTime @map("reset_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([namespace, clientHash])
  @@index([resetAt], map: "rate_limit_buckets_reset_at_idx")
  @@map("rate_limit_buckets")
}

model Vendor {
  id               String       @id @default(cuid())
  companyName      String       @map("company_name")
  slug             String       @unique
  category         String
  contactName      String?      @map("contact_name")
  email            String
  phone            String?
  websiteUrl       String?      @map("website_url")
  address          String?
  postalCode       String?      @map("postal_code")
  city             String?
  cantonId         String?      @map("canton_id")
  serviceRegions   String[]     @default([]) @map("service_regions")
  shortDescription String?      @map("short_description")
  longDescription  String?      @map("long_description")
  priceRange       String?      @map("price_range")
  languages        String[]     @default([])
  styleTags        String[]     @default([]) @map("style_tags")
  logoUrl          String?      @map("logo_url")
  galleryImages    String[]     @default([]) @map("gallery_images")
  premium          Boolean      @default(false)
  featured         Boolean      @default(false)
  published        Boolean      @default(false)
  leadEmail        String?      @map("lead_email")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  canton           Canton?      @relation(fields: [cantonId], references: [id])
  vendorLeads      VendorLead[]

  @@map("vendors")
}

model VendorLead {
  id            String    @id @default(cuid())
  leadId        String    @map("lead_id")
  vendorId      String    @map("vendor_id")
  status        String    @default("new")
  sentAt        DateTime? @map("sent_at")
  acceptedAt    DateTime? @map("accepted_at")
  priceCharged  Decimal?  @map("price_charged")
  createdAt     DateTime  @default(now()) @map("created_at")
  lead          Lead      @relation(fields: [leadId], references: [id])
  vendor        Vendor    @relation(fields: [vendorId], references: [id])

  @@map("vendor_leads")
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("admin")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}
