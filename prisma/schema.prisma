generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Canton {
  id              String                @id @default(cuid())
  nameDe          String                @map("name_de")
  nameFr          String?               @map("name_fr")
  nameIt          String?               @map("name_it")
  slug            String                @unique
  abbreviation    String
  description     String?
  metaTitle       String?               @map("meta_title")
  metaDescription String?               @map("meta_description")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  cities          City[]
  offices         CivilRegistryOffice[]
  leads           Lead[]
  vendors         Vendor[]

  @@map("cantons")
}

model City {
  id              String                @id @default(cuid())
  name            String
  slug            String                @unique
  cantonId        String                @map("canton_id")
  postalCode      String?               @map("postal_code")
  description     String?
  metaTitle       String?               @map("meta_title")
  metaDescription String?               @map("meta_description")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  canton          Canton                @relation(fields: [cantonId], references: [id])
  offices         CivilRegistryOffice[]
  leads           Lead[]

  @@map("cities")
}

model CivilRegistryOffice {
  id                         String    @id @default(cuid())
  name                       String
  slug                       String    @unique
  cantonId                   String    @map("canton_id")
  cityId                     String?   @map("city_id")
  addressLine1               String    @map("address_line_1")
  addressLine2               String?   @map("address_line_2")
  postalCode                 String    @map("postal_code")
  city                       String
  phone                      String?
  email                      String?
  websiteUrl                 String    @map("website_url")
  appointmentUrl             String?   @map("appointment_url")
  openingHours               String?   @map("opening_hours")
  latitude                   Float?
  longitude                  Float?
  languages                  String[]  @default([])
  responsibleMunicipalities  String[]  @default([]) @map("responsible_municipalities")
  description                String?
  documentsInfo              String?   @map("documents_info")
  ceremonyInfo               String?   @map("ceremony_info")
  imageUrl                   String?   @map("image_url")
  sourceUrl                  String    @map("source_url")
  lastVerifiedAt             DateTime? @map("last_verified_at")
  published                  Boolean   @default(false)
  metaTitle                  String?   @map("meta_title")
  metaDescription            String?   @map("meta_description")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  canton                     Canton    @relation(fields: [cantonId], references: [id])
  cityRelation               City?     @relation(fields: [cityId], references: [id])
  leads                      Lead[]

  @@map("civil_registry_offices")
}

model GuideArticle {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  category        String
  excerpt         String?
  content         String
  author          String?
  status          String    @default("draft")
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  canonicalUrl    String?   @map("canonical_url")
  publishedAt     DateTime? @map("published_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("guide_articles")
}

model Lead {
  id                        String                @id @default(cuid())
  leadType                  String                @map("lead_type")
  firstName                 String                @map("first_name")
  lastName                  String?               @map("last_name")
  email                     String
  phone                     String?
  cantonId                  String?               @map("canton_id")
  cityId                    String?               @map("city_id")
  registryOfficeId          String?               @map("registry_office_id")
  weddingDate               DateTime?             @map("wedding_date")
  guestCount                Int?                  @map("guest_count")
  budgetRange               String?               @map("budget_range")
  requestedVendorCategories String[]              @default([]) @map("requested_vendor_categories")
  stylePreferences          String[]              @default([]) @map("style_preferences")
  message                   String?
  consentPrivacy            Boolean               @map("consent_privacy")
  consentMarketing          Boolean               @default(false) @map("consent_marketing")
  consentTimestamp          DateTime              @default(now()) @map("consent_timestamp")
  sourcePage                String                @map("source_page")
  utmSource                 String?               @map("utm_source")
  utmMedium                 String?               @map("utm_medium")
  utmCampaign               String?               @map("utm_campaign")
  createdAt                 DateTime              @default(now()) @map("created_at")
  canton                    Canton?               @relation(fields: [cantonId], references: [id])
  city                      City?                 @relation(fields: [cityId], references: [id])
  registryOffice            CivilRegistryOffice?  @relation(fields: [registryOfficeId], references: [id])
  vendorLeads               VendorLead[]

  @@map("leads")
}

model WebsiteLead {
  id                String   @id @default(uuid()) @db.Uuid
  leadType          String   @map("lead_type")
  email             String
  firstName         String   @default("") @map("first_name")
  payload           Json
  dedupeWeddingDate String?  @map("dedupe_wedding_date")
  dedupeLocation    String?  @map("dedupe_location")
  duplicateOfId     String?  @db.Uuid @map("duplicate_of_id")
  status            String   @default("new")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([leadType, email, dedupeWeddingDate, dedupeLocation], map: "website_leads_dedupe_idx")
  @@index([createdAt(sort: Desc)], map: "website_leads_created_at_idx")
  @@map("website_leads")
}

model AnalyticsEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventName   String   @map("event_name")
  sessionId   String   @db.Uuid @map("session_id")
  visitorHash String   @map("visitor_hash")
  path        String
  country     String   @default("CH")
  properties  Json
  occurredAt  DateTime @default(now()) @map("occurred_at")

  @@index([occurredAt(sort: Desc)], map: "analytics_events_occurred_at_idx")
  @@index([eventName, occurredAt(sort: Desc)], map: "analytics_events_name_time_idx")
  @@map("analytics_events")
}

model RateLimitBucket {
  namespace  String
  clientHash String   @map("client_hash")
  count      Int
  resetAt    DateTime @map("reset_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([namespace, clientHash])
  @@index([resetAt], map: "rate_limit_buckets_reset_at_idx")
  @@map("rate_limit_buckets")
}

model Vendor {
  id               String       @id @default(cuid())
  companyName      String       @map("company_name")
  slug             String       @unique
  category         String
  contactName      String?      @map("contact_name")
  email            String
  phone             String?
  websiteUrl       String?      @map("website_url")
  address          String?
  postalCode       String?      @map("postal_code")
  city             String?
  cantonId         String?      @map("canton_id")
  serviceRegions   String[]     @default([]) @map("service_regions")
  shortDescription String?      @map("short_description")
  longDescription  String?      @map("long_description")
  priceRange       String?      @map("price_range")
  languages        String[]     @default([])
  styleTags        String[]     @default([]) @map("style_tags")
  logoUrl          String?      @map("logo_url")
  galleryImages    String[]     @default([]) @map("gallery_images")
  premium          Boolean      @default(false)
  featured         Boolean      @default(false)
  published        Boolean      @default(false)
  leadEmail        String?      @map("lead_email")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  canton           Canton?      @relation(fields: [cantonId], references: [id])
  vendorLeads      VendorLead[]

  @@map("vendors")
}

model VendorLead {
  id            String    @id @default(cuid())
  leadId        String    @map("lead_id")
  vendorId      String    @map("vendor_id")
  status        String    @default("new")
  sentAt        DateTime? @map("sent_at")
  acceptedAt    DateTime? @map("accepted_at")
  priceCharged  Decimal?  @map("price_charged")
  createdAt     DateTime  @default(now()) @map("created_at")
  lead          Lead      @relation(fields: [leadId], references: [id])
  vendor        Vendor    @relation(fields: [vendorId], references: [id])

  @@map("vendor_leads")
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("admin")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model AvailabilitySource {
  id                    String             @id @default(uuid()) @db.Uuid
  targetType            String             @map("target_type")
  targetCanonicalId     String?            @map("target_canonical_id")
  targetSlug            String             @map("target_slug")
  providerType          String             @map("provider_type")
  sourceUrl             String             @map("source_url")
  connectorKey          String             @map("connector_key")
  sourceQuality         String             @map("source_quality")
  active                Boolean            @default(false)
  syncFrequencyMinutes  Int                @default(1440) @map("sync_frequency_minutes")
  lastCheckedAt         DateTime?          @map("last_checked_at")
  lastSuccessAt         DateTime?          @map("last_success_at")
  lastChangedAt         DateTime?          @map("last_changed_at")
  lastError             String?            @map("last_error")
  metadata              Json?
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  slots                 AvailabilitySlot[]

  @@unique([targetType, targetSlug, sourceUrl], map: "availability_sources_target_source_key")
  @@index([active, lastCheckedAt], map: "availability_sources_active_checked_idx")
  @@index([targetCanonicalId], map: "availability_sources_canonical_idx")
  @@index([targetType, targetSlug], map: "availability_sources_target_idx")
  @@map("availability_sources")
}

model AvailabilitySlot {
  id              String             @id @default(uuid()) @db.Uuid
  sourceId        String             @db.Uuid @map("source_id")
  externalKey     String             @map("external_key")
  date            DateTime           @db.Date
  startAt         DateTime?          @map("start_at")
  endAt           DateTime?          @map("end_at")
  status          String
  precision       String
  checkedAt       DateTime           @default(now()) @map("checked_at")
  sourceUpdatedAt DateTime?          @map("source_updated_at")
  rawReference    String?            @map("raw_reference")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  source          AvailabilitySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalKey], map: "availability_slots_source_external_key")
  @@index([date, status], map: "availability_slots_date_status_idx")
  @@index([sourceId, date], map: "availability_slots_source_date_idx")
  @@map("availability_slots")
}

model AvailabilitySyncRun {
  id                String    @id @default(uuid()) @db.Uuid
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")
  status            String    @default("running")
  checkedSources    Int       @default(0) @map("checked_sources")
  successfulSources Int       @default(0) @map("successful_sources")
  failedSources     Int       @default(0) @map("failed_sources")
  metadata          Json?

  @@index([startedAt(sort: Desc)], map: "availability_sync_runs_started_idx")
  @@map("availability_sync_runs")
}

model Photographer {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  websiteUrl      String?     @map("website_url")
  instagramHandle String?     @map("instagram_handle")
  email           String?
  region          String?
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  photoLeads      PhotoLead[]

  @@index([name], map: "photographers_name_idx")
  @@map("photographers")
}

model PhotoLead {
  id                String           @id @default(uuid()) @db.Uuid
  targetType        String           @default("venue") @map("target_type")
  targetCanonicalId String?          @map("target_canonical_id")
  targetSlug        String           @map("target_slug")
  photographerId    String?          @db.Uuid @map("photographer_id")
  source            String
  sourceUrl         String           @map("source_url")
  imageUrl          String?          @map("image_url")
  postDate          DateTime?        @map("post_date")
  confidence        Int              @default(0)
  status            String           @default("found")
  contactedAt       DateTime?        @map("contacted_at")
  lastCheckedAt     DateTime?        @map("last_checked_at")
  fingerprint       String           @unique
  metadata          Json?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  photographer      Photographer?    @relation(fields: [photographerId], references: [id], onDelete: SetNull)
  permission        PhotoPermission?
  venuePhotos       VenuePhoto[]

  @@unique([sourceUrl], map: "photo_leads_source_url_key")
  @@index([targetType, targetSlug], map: "photo_leads_target_idx")
  @@index([status, confidence(sort: Desc)], map: "photo_leads_status_idx")
  @@index([photographerId], map: "photo_leads_photographer_idx")
  @@map("photo_leads")
}

model PhotoPermission {
  id                  String    @id @default(uuid()) @db.Uuid
  photoLeadId         String    @unique @db.Uuid @map("photo_lead_id")
  status              String    @default("pending")
  requestedAt         DateTime? @map("requested_at")
  respondedAt         DateTime? @map("responded_at")
  usageTerms          String?   @map("usage_terms")
  attributionRequired Boolean   @default(true) @map("attribution_required")
  attributionText     String?   @map("attribution_text")
  attributionUrl      String?   @map("attribution_url")
  proofReference      String?   @map("proof_reference")
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  photoLead           PhotoLead @relation(fields: [photoLeadId], references: [id], onDelete: Cascade)

  @@index([status], map: "photo_permissions_status_idx")
  @@map("photo_permissions")
}

model VenuePhoto {
  id                String     @id @default(uuid()) @db.Uuid
  targetCanonicalId String?    @map("target_canonical_id")
  targetSlug        String     @map("target_slug")
  photoLeadId       String?    @db.Uuid @map("photo_lead_id")
  imageUrl          String     @map("image_url")
  altText           String?    @map("alt_text")
  sortOrder         Int        @default(0) @map("sort_order")
  active            Boolean    @default(true)
  photographerName  String?    @map("photographer_name")
  attributionText   String?    @map("attribution_text")
  attributionUrl    String?    @map("attribution_url")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  photoLead         PhotoLead? @relation(fields: [photoLeadId], references: [id], onDelete: SetNull)

  @@index([targetSlug, active, sortOrder], map: "venue_photos_target_idx")
  @@index([photoLeadId], map: "venue_photos_photo_lead_idx")
  @@map("venue_photos")
}
